# Copy to .env and adjust. DO NOT commit .env to version control.

# Host port bindings (host:container). Bound to localhost only.
HERMES_API_PORT_BINDING=127.0.0.1:8642:8642
HERMES_DASHBOARD_PORT_BINDING=127.0.0.1:9119:9119

# Web dashboard basic auth
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change_me_now
